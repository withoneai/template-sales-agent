# Leave everything empty to run in demo mode (sample data, nothing leaves
# your machine). Fill it in to run the agent on your own CRM and inbox.

# ---------------------------------------------------------------- One Connect
# Create at app.withone.ai -> Developers -> Connect -> New app.
# Redirect URI to register, exactly:  http://localhost:3000/api/one/callback
ONE_CLIENT_ID=
ONE_CLIENT_SECRET=
ONE_REDIRECT_URI=http://localhost:3000/api/one/callback
# The ask the consent page opens on (Attio, HubSpot, Gmail, Resend). Optional:
# without it, One lists everything the user has connected.
ONE_PERMISSION_SET=

# ---------------------------------------------------------------- The model
ANTHROPIC_API_KEY=
# Optional. Default: claude-opus-5-5
ANTHROPIC_MODEL=
